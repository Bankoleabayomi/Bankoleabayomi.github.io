	keywords = {Bagging, Bootstrapping, Exponential smoothing, {STL} decomposition},
	file = {ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\46SL9WC6\\S0169207015001120.html:text/html;Submitted Version:C\:\\Users\\banko\\Zotero\\storage\\58HCYQNK\\Bergmeir et al. - 2016 - Bagging exponential smoothing methods using STL de.pdf:application/pdf},
}

@article{niknam_critical_2022,
	title = {A Critical Review of Short-Term Water Demand Forecasting Tools—What Method Should I Use?},
	volume = {14},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2071-1050},

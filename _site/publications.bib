	keywords = {Computer Science - Computer Vision and Pattern Recognition},
	file = {arXiv Fulltext PDF:C\:\\Users\\banko\\Zotero\\storage\\C4UUCL4H\\Wang et al. - 2019 - CSPNet A New Backbone that can Enhance Learning C.pdf:application/pdf;arXiv.org Snapshot:C\:\\Users\\banko\\Zotero\\storage\\MPN2QIWF\\1911.html:text/html},

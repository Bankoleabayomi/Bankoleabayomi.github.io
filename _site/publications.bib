@article{sparks_feedforward-feedback_2026-1,
	title = {Feedforward-feedback ammonia control at a water resource recovery facility based on a digital twin with hybrid model},
	volume = {83},
	issn = {2214-7144},
	url = {https://www.sciencedirect.com/science/article/pii/S2214714426002242},
	doi = {10.1016/j.jwpe.2026.109666},
	abstract = {Ammonia-based aeration control ({ABAC}) at full-scale Water Resource Recovery Facilities ({WRRFs}) can be challenged by diurnal loading and transport delays. This work addressed these challenges using a hybrid feedforward–feedback controller built on Activated Sludge Model 1 ({ASM}1), marking the first full-scale deployment to pair a mechanistic feedforward core with data-driven corrections. The objectives were to improve ammonia setpoint tracking, assess performance of the mechanistic model when enhanced with data-driven corrections, and document full-scale operation. The hybrid model incorporates two data-driven components: (1) a Mechanistic Error Forecasting Engine ({MEFE}), consisting of a multivariate linear regressor and a long short-term memory ({LSTM}) ensemble. Defying expectations, low-parameter models outperformed more complex alternatives, reducing the mechanistic error by 71\%. (2) A Residual Oscillation Forecasting Engine ({ROFE}), based on Fast Fourier Transform, reduced the remaining error by another 35\%. Two proportional–integral ({PI}) feedback loops further (i) trim the feedforward output and (ii) eliminate residual controller error in the final aerobic zone. In full-scale operation, the controller reduced mean-squared error ({MSE}) by 94\% over the baseline and produced more stable dissolved oxygen ({DO}) setpoints. Overall, it was proven that layering multi-timescale data-driven models on a mechanistic core can yield reliable {ABAC} performance at {WRRFs}.},
	pages = {109666},
	journaltitle = {Journal of Water Process Engineering},
	author = {Sparks, J. A. and Bott, C. B. and Vanrolleghem, P. A.},
	urldate = {2026-05-06},
	date = {2026-03-01},
	keywords = {Machine learning, Hybrid model, Data-driven model, Ammonia-based aeration control, Digital twin},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\P7ZIC6U3\\Sparks et al. - 2026 - Feedforward-feedback ammonia control at a water resource recovery facility based on a digital twin w.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\VHS6X69X\\S2214714426002242.html:text/html},
}

@article{li_floc_2026,
	title = {Floc image recognition based on multimodal fusion to provide predictive feedback in coagulation},
	volume = {86},
	issn = {2214-7144},
	url = {https://www.sciencedirect.com/science/article/pii/S2214714426005246},
	doi = {10.1016/j.jwpe.2026.109966},
	abstract = {Recent advances in deep learning ({DL}) have enabled predictive feedforward control for efficient coagulant dosing management, providing momentum and direction for its predictive feedback loop in drinking water treatment plants ({DWTPs}), which is critical for managing water resources sustainably. However, the failure of conventional feedback based on floc image recognition to consider crucial information from other modalities, with insufficient data acquisition and processing, posed a performance bottleneck in predicting coagulation effects. This study proposed a novel dual-branch multimodal model based on hybrid fusion strategy combining the end-to-end floc image recognition branch and the feature fusion branch that considered floc features, water quality and process parameters. The further designed adaptive data augmentation and image pixel-based floc feature extraction solved data blurring, noise interference and category imbalance issues, ensuring robust and reliable multimodal fusion and model training. The results demonstrate that the proposed multimodal model outperformed single-modal Xception and multimodal Catboost with {AUC} of 0.999, which employed time-lock image acquisition without continuous monitoring floc images. Furthermore, gradient-weighted class activation mapping (Grad-{CAM}++) visualization confirmed the trustworthiness of model decisions. The prediction performance of the proposed model was sustained over the 30-day tracking of the partner {DWTP}.},
	pages = {109966},
	journaltitle = {Journal of Water Process Engineering},
	author = {Li, Bowen and Lin, Peng and Liu, Feng and Liu, Zehong and Liu, Li and Li, Kexun},
	urldate = {2026-05-06},
	date = {2026-04-01},
	keywords = {Floc formation, Convolutional neural network, Image recognition, Multimodal fusion, Predictive feedback loop},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\E4KBX7TU\\Li et al. - 2026 - Floc image recognition based on multimodal fusion to provide predictive feedback in coagulation.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\C9PW72TD\\S2214714426005246.html:text/html},
}

@article{li_characteristic_2025-2,
	title = {Characteristic analysis of floc size distribution and image texture evolution in chemical coagulation process},
	volume = {199},
	issn = {09575820},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0957582025005658},
	doi = {10.1016/j.psep.2025.107298},
	abstract = {The dynamic evolution characteristics of flocs during chemical coagulation play a critical role in water treatment process optimization, yet real-time monitoring of reaction conditions and floc morphology remains challenging. This study innovatively integrates machine vision with image texture analysis to systematically investigate the regulatory mechanisms of coagulant dosage and raw water turbidity on floc size distribution and textural features. A non-invasive high-speed imaging system was employed to capture the entire flocculation dynamics, coupled with Python-{OpenCV} algorithms for quantitative characterization of floc parameters. Results demonstrate that under constant turbidity: (1) Insufficient coagulant dosage leads to inadequate colloidal destabilization, manifested by reduced floc quantity and significant decreases in image gray mean, entropy, and correlation values; (2) Optimal dosage produces concentrated floc size distribution with low coefficient of variation ({CV}); (3) Overdosing induces floc erosion and fragmentation, forming bi-/tri-modal distributions with substantially increased {CV}. Furthermore, high-turbidity raw water exacerbates floc fragmentation, resulting in dispersed size distribution (elevated {CV}) and enhanced light scattering (improved texture contrast). This work first elucidates the synergistic evolution between image textural features and floc size distribution, confirming their potential as sensitive indicators for real-time coagulant optimization, thereby providing theoretical foundations for intelligent control of coagulation processes.},
	pages = {107298},
	journaltitle = {Process Safety and Environmental Protection},
	author = {Li, Shuaishuai and Liu, Yuling and Wang, Zhixiao and Dou, Chuanchuan and Zhao, Wangben and Shu, Hao},
	urldate = {2026-05-25},
	date = {2025-07},
	langid = {english},
	file = {PDF:C\:\\Users\\banko\\Zotero\\storage\\YJTEM45C\\Li et al. - 2025 - Characteristic analysis of floc size distribution and image texture evolution in chemical coagulatio.pdf:application/pdf},
}


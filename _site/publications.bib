	langid = {english},
	keywords = {Diapers, Phthalates, Sanitary pads, {VOCs}},
	file = {Accepted Version:C\:\\Users\\banko\\Zotero\\storage\\679MU4AD\\Park et al. - 2019 - Sanitary pads and diapers contain higher phthalate.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\M7UX98WB\\S0890623818302259.html:text/html},

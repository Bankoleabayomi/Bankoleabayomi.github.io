@article{adediran_continental_1991,
	title = {The continental sediments of the Nigerian Coastal Basins},
	volume = {12},
	issn = {0899-5362},
	url = {https://www.sciencedirect.com/science/article/pii/0899536291900598},
	doi = {10.1016/0899-5362(91)90059-8},
	series = {Sedimentary and Diagenetic Dynamics of Continental Phanerozoic Sediments in Africa},
	abstract = {The development of the coastal basins of Nigeria is examined in terms of a four-stage evolutionary model, viz: intracratonic, synrift, transitional and oceanic. The continental sediments range in age from early Cretaceous to Recent. The oldest sediments in the Western Dahomey Basin (Ise Formation) consist of a predrift sequence of basal conglomerates and loose sands interbedded with clays. Sedimentation in the eastern basins commenced later during the Albian times with the deposition of coarse grained, poorly sorted sands (Mamfe and Awi Formations) of fluviatile origin. These are overlain in all basins by transitional to marine strata. Continental sedimentation resumed in the Maastricthian with the deposition of coarse grained, poorly sorted, sometimes ferruginuous sands and clays (Owelli and Ajali Sandstones). Regression began during the Eocene resulting in the deposition of fine to coarse grained, poorly sorted sands with mudstones (Ilaro Formation) in the west, overlain by crossbedded sandstones with lignites and carbonaceous mudstone (Ogwashi-Asaba Formation). Miocene to Recent limonitic, coarse grained, subangular to well-rounded Benin Sands cap all the basins.
Résumé
L'évolution des bassins côtiers du Nigéria suit un cheminement en quatre étapes: intracratonique, synrift, transitionnel et océanique. Les sédiments continentaux s'échelonnent du Crétacé à l'Actuel. Les sédiments les plus anciens dans le bassin du Dahomey à l'Ouest (Formation d'Ise) consistent en une séquence pré-rift de conglomérats de base et de sables meubles interstratifiés avec des argiles. La sédimentation dans les bassins orientaux débute au cours de l'Albien avec le dépôt de sables grossiers et mal triés (Formation de Mamfe et d'Awi) d'origine fluviatile. Ils sont surmontés dans tous les bassins par des couches transitionnelles à marines. La sédimentation continentale s'est résumée au Maastrichtien par le dépôt d'argiles et de sables grossiers, mal triés, parfois ferrugineux (grès d'Owelli et d'Ajali). La régression éocène s'est traduite par le dépôt de sables fins à grossiers, mal triés, avec des mudstones (Formation d'Ilaro) à l'ouest, surmontés par des grès à stratifications entreccoisées avec des lignites et des mudstones carbonés (Formation d'Ogwashi-Asaba). Tous les bassins sont couronnés par les sables à limonite du Bénin, grossiers, subanguleux à arrondis, d'âge Miocène à actuel.},
	pages = {79--84},
	number = {1},
	journaltitle = {Journal of African Earth Sciences (and the Middle East)},
	author = {Adediran, S. A. and Adegoke, O. S. and Oshin, I. O.},
	urldate = {2021-09-28},
	date = {1991-01-01},
	langid = {english},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\X5AYLZMR\\Adediran et al. - 1991 - The continental sediments of the Nigerian Coastal .pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\RQPTMMKL\\0899536291900598.html:text/html},
}


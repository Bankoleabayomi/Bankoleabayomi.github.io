	note = {Number: 9},
	keywords = {artificial intelligence, water pollution, adsorption, membrane, precipitation},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\XDB7VJSU\\Altowayti et al. - 2022 - The Role of Conventional Methods and Artificial In.pdf:application/pdf;Snapshot:C\:\\Users\\banko\\Zotero\\storage\\XKECF8T2\\htm.html:text/html},

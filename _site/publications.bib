	urldate = {2022-04-12},
	date = {2022-09-01},
	langid = {english},
	keywords = {Water quality, Drainage water reuse, El-Bats drain, Fayoum Governorate},
	file = {Khairy et al. - 2022 - Drainage water reuse strategies Case of El-Bats d.pdf:C\:\\Users\\banko\\Zotero\\storage\\2NU6J7R6\\Khairy et al. - 2022 - Drainage water reuse strategies Case of El-Bats d.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\56LN9LLL\\S2090447921004597.html:text/html},

	journaltitle = {Journal of Hydrology: Regional Studies},
	author = {Zhang, Yuanda and Wang, Peijuan and Chen, Yuye and Yang, Jianying and Wu, Dingrong and Ma, Yuping and Huo, Zhiguo and Liu, Shuxian},
	urldate = {2025-08-08},

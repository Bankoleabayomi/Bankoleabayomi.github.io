@article{du_visual_2025,
	title = {Visual Information-guided Physics-Informed Neural Network ({VI}-{PINN}) for predictive forecasting and control of the flocculation sedimentation process},
	volume = {232},
	issn = {0892-6875},
	url = {https://www.sciencedirect.com/science/article/pii/S0892687525003322},
	doi = {10.1016/j.mineng.2025.109504},
	abstract = {Real-time visual information holds significant potential for revealing the internal states of tailings flocculation-sedimentation processes in paste preparation. Although industry typically relies on turbidity measurements and researchers use flocculation degree ({DF}) for quantification, both indicators have physical lags of minutes in evaluating the flocculation and settling state of dense interiors. This delay occurs because these metrics reflect the outcomes of internal particle aggregation and sedimentation, which require time to propagate and manifest in the supernatant. This information lag constrains traditional control systems to reactive adjustments based on past states, preventing proactive control and resulting in sluggish responses and inefficiencies. This paper introduces a Visual Information-guided Physics-Informed Neural Network ({VI}-{PINN}) framework that overcomes these limitations by integrating deep vision’s real-time perception capabilities with physical law constraints. {VI}-{PINN} extracts early predictive visual features through a {ConvNeXt} network, maps these features to the time-varying effective sedimentation velocity v0(t) in the Kynch sedimentation Partial Differential Equation ({PDE}), and embeds them into {PINN} with rigorous physical constraints. Experimental results demonstrate {VI}-{PINN}’s superior performance, with {DFt} predictions significantly outperforming the purely data-driven Multi-Head Attention {ConvNeXt} ({MHA}-{ConvNeXt}) benchmark (R2 improved from 0.858 to 0.912, {RMSE} reduced by 26 \%) while maintaining extremely low {PDE} residuals ({\textless}10−4). Mechanism analysis validated the vision-driven dynamics of the key physical parameter v0(t). {VI}-{PINN} also inferred plausible internal states, exhibited excellent generalization to unseen conditions (R2 = 0.9 for varying concentrations/particle sizes), and, in closed-loop control, reduced disturbance recovery time by 61 \% and fluctuations by 72 \% versus Proportional-Integral-Derivative ({PID}), decisively overcoming measurement lag for proactive control.},
	pages = {109504},
	journaltitle = {Minerals Engineering},
	author = {Du, Shuangcheng and Chang, Yingjie and Wang, Yiren and Wang, Hongjiang},
	urldate = {2025-06-26},
	date = {2025-10-01},
	keywords = {Flocculation-Sedimentation, Measurement Lag, Proactive Control, {VI}-{PINN}},
	file = {Du et al. - 2025 - Visual Information-guided Physics-Informed Neural .pdf:C\:\\Users\\banko\\Zotero\\storage\\N9R5QHLX\\Du et al. - 2025 - Visual Information-guided Physics-Informed Neural .pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\MV8LQMIK\\S0892687525003322.html:text/html},
}


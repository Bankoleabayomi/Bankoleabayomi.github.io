	shorttitle = {Trends in access to water supply and sanitation in 31 major sub-Saharan African cities},
	abstract = {By 2050, sub-Saharan Africa’s ({SSA}) urban population is expected to grow from 414 million to over 1.2 billion. This growth will likely increase challenges to municipalities attempting to provide access to water supply and sanitation ({WS}\&S). This study aims to characterize trends in access to {WS}\&S in {SSA} cities and identify factors affecting those trends.},

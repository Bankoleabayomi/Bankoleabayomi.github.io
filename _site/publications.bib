	author = {Bernardelli, A. and Marsili-Libelli, S. and Manzini, A. and Stancari, S. and Tardini, G. and Montanari, D. and Anceschi, G. and Gelli, P. and Venier, S.},
	date = {2020},
	keywords = {Machine learning, Artificial Intelligence, Model predictive control, Neuro-fuzzy computing, Nutrient removal, Real-time control},

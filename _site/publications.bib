@article{marx_economics_2013,
	title = {The Economics of Slums in the Developing World},
	volume = {27},
	issn = {0895-3309},
	url = {https://www.aeaweb.org/articles?id=10.1257/jep.27.4.187},
	doi = {10.1257/jep.27.4.187},
	abstract = {The global expansion of urban slums poses questions for economic research as well as
problems for policymakers. We provide evidence that the type of poverty observed in
contemporary slums of the developing world is characteristic of that described in the
literature on poverty traps. We document how human capital threshold effects,
investment inertia, and a "policy trap" may prevent slum dwellers from seizing economic
opportunities offered by geographic proximity to the city. We test the assumptions of
another theory -- that slums are a just transitory phenomenon characteristic of fastgrowing
economies -- by examining the relationship between economic growth, urban
growth, and slum growth in the developing world, and whether standards of living of
slum dwellers are improving over time, both within slums and across generations.
Finally, we discuss why standard policy approaches have often failed to mitigate the
expansion of slums in the developing world. Our aim is to inform public debate on the
essential issues posed by slums in the developing world.},
	pages = {187--210},
	number = {4},
	journaltitle = {Journal of Economic Perspectives},
	author = {Marx, Benjamin and Stoker, Thomas and Suri, Tavneet},
	urldate = {2022-05-27},
	date = {2013-11},
	langid = {english},
	keywords = {Human Development, Income Distribution, Population, Regional Labor Markets, Housing, Infrastructure, Regional Economic Activity: Growth, Development, Environmental Issues, and Changes, Urban, Rural, Regional, Real Estate, and Transportation Economics: Regional Migration, Measurement and Analysis of Poverty, Welfare, Well-Being, and Poverty: Government Programs, Migration, Economic Development: Urban, Rural, Regional, and Transportation Analysis, Neighborhood Characteristics, Regional Development Planning and Policy, Provision and Effects of Welfare Programs, Economic Development: Human Resources},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\4CB6E3W6\\Marx et al. - 2013 - The Economics of Slums in the Developing World.pdf:application/pdf;Snapshot:C\:\\Users\\banko\\Zotero\\storage\\EN2V2XCE\\articles.html:text/html},
}

@article{ferreira_investment_2021,
	title = {Investment in drinking water and sanitation infrastructure and its impact on waterborne diseases dissemination: The Brazilian case},
	volume = {779},
	issn = {0048-9697},
	url = {https://www.sciencedirect.com/science/article/pii/S0048969721013474},
	doi = {10.1016/j.scitotenv.2021.146279},
	shorttitle = {Investment in drinking water and sanitation infrastructure and its impact on waterborne diseases dissemination},
	abstract = {Investment in sanitation and drinking water infrastructure is essential for universal access to these services in developing countries. Universal coverage of water and sanitation services ({WSS}) can prevent the dissemination of waterborne diseases and mitigate their adverse effects. These diseases are responsible for many deaths worldwide, especially among the disadvantaged population and children. A causal effect can be established between {WSS} investment and hospital admissions due to waterborne diseases. Therefore, we considered an innovative network-{DEA} approach that models the link between serially connected subsystems (upstream investment and downstream hospitalizations). This approach allowed us: to measure the efficiency of both subsystems; estimate the amount of (efficient) investment necessary to universalize the access to proper {WSS} infrastructure; and mitigate hospital admissions due to waterborne diseases. We used the Brazil case study to test our model. On average, Brazilian states could increase the number of people not requiring hospitalizations due to waterborne diseases by 157 thousand per R\$100 million invested in sanitation and 26 thousand per R\$100 million invested in drinking water. Our results suggest that relatively small (efficient) investment in those two infrastructure types has a massive impact on hospitalizations. This impact would be more significant than the investment in {WSS} coverage. Therefore, if safely managed, {WSS} would cover all citizens, and Brazil would come closer to developed countries.},
	pages = {146279},
	journaltitle = {Science of The Total Environment},
	author = {Ferreira, Diogo Cunha and Graziele, Ingrid and Marques, Rui Cunha and Gonçalves, Jorge},
	urldate = {2022-05-26},
	date = {2021-07-20},
	langid = {english},
	keywords = {Public health, Brazil, Drinking water coverage, Investment in infrastructure, Sanitation coverage, Waterborne diseases},
	file = {Ferreira et al. - 2021 - Investment in drinking water and sanitation infras.pdf:C\:\\Users\\banko\\Zotero\\storage\\HPY79JFH\\Ferreira et al. - 2021 - Investment in drinking water and sanitation infras.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\4WXXVTHY\\S0048969721013474.html:text/html},
}

@article{bollmann_influence_2006,
	title = {Influence of the urban density in the relationship among carbonic organic matter, nitrogen and phosphorous in small rivers with low sanitation coverage},
	volume = {11},
	issn = {1413-4152},
	doi = {10.1590/s1413-41522006000400007},
	shorttitle = {Influência da densidade populacional nas relações entre matéria orgânica carbonácea, nitrogênio e fósforo em rios urbanos situados em áreas com baixa cobertura sanitária},
	abstract = {The purpose of this study is to evaluate the relationship among the carbonic organic matter (measured as Chemical and Biological Oxygen Demand), Total Kjeldhal Nitrogen and Total Phosphorous in small urban rivers with low sanitation coverage in its hydrographic basins. Four basins with similar natural condition and residential occupation but variable urban densities between 0 and 100 inhabitants per hectare were selected. The results show important changes in the carbonic organic matter, Nitrogen and Phosphorous relationships indicating that, compared with a natural condition, even low urban densities can significantly change de water quality.},
	pages = {343--352},
	number = {4},
	journaltitle = {Engenharia Sanitaria e Ambiental},
	author = {Bollmann, H.A. and Da Motta Marques, D.M.L.},
	date = {2006},
	keywords = {Water quality, Pollution, urban rivers},

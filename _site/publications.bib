@article{ekhator_assessment_2015,
	title = {Assessment of Water Quality Index ({WQI}) for Osse River in Edo State, Southern Nigeria},
	volume = {15},
	abstract = {Water quality index ({WQI}) is an important tool in the assessment and management of water resources.The present study was carried out to assess the water quality index of Osse River in Edo State,Nigeria.In this study, {WQI} was determined on the basis of some selected physico-chemical parameters like ({pH}, dissolved oxygen ({DO}) (mg/l),conductivity (µS/cm),turbidity ({NTU}),biochemical oxygen demand ({BOD}) (mg/l),nitrate (mg/l), sulphate (mg/l), phosphate (mg/l), total hardness ({TH}) (mg/l), calcium (mg/l), magnesium (mg/l), alkalinity (mg/l), total dissolved solids ({TDS}) (mg/l) and chloride (mg/l)).Five stations comprising three freshwater zones and two brackish zones were investigated. Results showed that mean {WQI} values of Osse River ranged from 89.676±41 to 550.678±182 across the five stations with highest {WQI} values observed in the rainy months as a result of flooding, anthropogenic activities and intrusion from the sea. Stations 1 and 2 fell under the category of poor water, station 3, good water, station 4, bad water and station 5, unsuitable for drinking. Osse River was assessed as not fit for human consumption without proper treatment. However, it can be used for other activities.},
	pages = {2015--2046},
	author = {Ekhator, Osagie and Izegaegbe, Joshua and Osadebamwen, Odaro},
	date = {2015-10-10},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\R3YDC5PT\\Ekhator et al. - 2015 - Assessment of Water Quality Index (WQI) for Osse R.pdf:application/pdf},
}

@article{oyeyemi_radiological_2017,
	title = {Radiological Risks Assessment of Ogun State Drinking Water},
	doi = {10.3844/ajassp.2017},
	abstract = {The presence of radionuclides in water constitute health risk to man. The consumption of such water increases the likelihood of incurring cancer. Analysis will enhance the detection of significant radionuclides causing harm to the populace and stimulate remediation. This inferred the radioactivity measurements of twenty (20) well water samples from three industrial cities of Ogun State using Hyper Pure Germanium detector ({HPGe}). The {pH} and other physiochemical parameters were also determined. The result showed that the mean activity concentrations of 40K, 210Pb, 224Ra, 232Th and 238U were found to be 1.86±1.70 Bql−1; 7.93±2.40 Bql−1; 3.60±1.25 Bql−1; 8.48±2.10 Bql−1; and 2.28±0.57 Bql−1 respectively. The corresponding mean total annual effective dose for ages 0-1 y; 1-2 y; 2-7 y; 7-12 y; 12-17 y and {\textgreater} 17 y are: 9.14 {mSv} y−1; 9.58 {mSv} y−1; 6.87
{mSv} y−1; 6.86 {mSv} y−1; 11.91 {mSv} y−1; and 5.68 {mSv} y−1 respectively. The mean cancer mortality and morbidity risks respectively are: \{(3.16 and 5.00)10−5\} for 40K; \{(575.74 and 759.67)10−5\} for 210Pb; \{(43.25 and 71.05)10−5\} for 224Ra; \{(63.37 and 96.03)10−5\} for232Th; and \{(10.70 and 16.40)10−5\} for 238U. The activity concentrations of 210Pb, 224Ra and 232Th exceeded the World Health Organization ({WHO}) guidance level in all samples but one. The corresponding total annual effective dose for all the six age groups exceeded the recommended {WHO} standard of 0.1 {mSv} y−1 in all samples. More importantly, there is high radiation risk in drinking the water from these wells and 210Pb contribution to risk was the highest.},
	journaltitle = {American Journal of Applied Sciences},
	author = {Oyeyemi, Kehinde},
	date = {2017-05-01},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\MZAGP72T\\Oyeyemi - 2017 - Radiological Risks Assessment of Ogun State Drinki.pdf:application/pdf},
}

@article{elueza_appraisal_2001,
	title = {Appraisal of the residual and sedimentary clays in parts of Abeokuta area, Southwestern Nigeria},
	volume = {37},
	abstract = {Lateritic clays abound at and near the contact between the basement and sedimentary rocks of Abeokuta area, southwestern Nigeria. Lithologic sections show that the residual clay bodies are weathered from porphyroblastic and migmatitic gneisses. They are generally gritty and reddish in colour. The overlying sedimentary clay of the Abeokuta Formation on the other hand are finer, and greyish in colour. Mineralogical studies reveal kaolinite (ca. 70\%) and quartz (ca. 10-20\%) as the dominant minerals present. However, the sedimentary clay exclusively contain about 10\% smectite. Chemical data shows that average {SlO}2, Al2O3, and Fe2O3 values of the residual clay are 60.0, 18.2 and 7.6\% respectively. Corresponding values for the sedimentary equivalent are 52.5, 28.7 and 3.3\%. Also {TIO}2, K2O and {CaO} mean values of both clay types are less than 2.0\%. Physical and industrial tests show that the clay bodies are dense and moderately plastic. The fired pellets prepared from them reflect low shrinkage values of 1.7 to 2.8 and water absorption capacity of ca.6.4\% in 24 hours. Comparative studies of the two genetically different clay bodies suggest that the sedimentary type are simpler in mineralogy, contain less chemical impurities, finer and more plastic. However, they occur as thin lenses of about 1m thick unlike their residual counterpart that could be up to 5m. The quality of the clays could be improved through appropriate beneficiation techniques while selective mining for ceramics, paper, paints, pesticides, fertilizer and refractory production could be undertaken through the open pit method.},
	pages = {7--14},
	author = {Elueza, A.A. and Bolarinwa, Anthony},
	date = {2001-01-01},
}

@article{kumpel_comparing_2013,
	title = {Comparing microbial water quality in an intermittent and continuous piped water supply},
	volume = {47},
	issn = {0043-1354},
	url = {http://www.sciencedirect.com/science/article/pii/S0043135413004909},
	doi = {10.1016/j.watres.2013.05.058},
	abstract = {Supplying piped water intermittently is a common practice throughout the world that increases the risk of microbial contamination through multiple mechanisms. Converting an intermittent supply to a continuous supply has the potential to improve the quality of water delivered to consumers. To understand the effects of this upgrade on water quality, we tested samples from reservoirs, consumer taps, and drinking water provided by households (e.g. from storage containers) from an intermittent and continuous supply in Hubli–Dharwad, India, over one year. Water samples were tested for total coliform, Escherichia coli, turbidity, free chlorine, and combined chlorine. While water quality was similar at service reservoirs supplying the continuous and intermittent sections of the network, indicator bacteria were detected more frequently and at higher concentrations in samples from taps supplied intermittently compared to those supplied continuously (p {\textless} 0.01). Detection of E. coli was rare in continuous supply, with 0.7\% of tap samples positive compared to 31.7\% of intermittent water supply tap samples positive for E. coli. In samples from both continuously and intermittently supplied taps, higher concentrations of total coliform were measured after rainfall events. While source water quality declined slightly during the rainy season, only tap water from intermittent supply had significantly more indicator bacteria throughout the rainy season compared to the dry season. Drinking water samples provided by households in both continuous and intermittent supplies had higher concentrations of indicator bacteria than samples collected directly from taps. Most households with continuous supply continued to store water for drinking, resulting in re-contamination, which may reduce the benefits to water quality of converting to continuous supply.},
	pages = {5176--5188},
	number = {14},
	journaltitle = {Water Research},
	author = {Kumpel, Emily and Nelson, Kara L.},
	urldate = {2020-03-12},
	date = {2013-09-15},
	langid = {english},
	keywords = {Water Purification, Water Quality, Water quality, India, Drinking Water, 24/7 water supply, Chlorine, Continuous water supply, Escherichia coli, Family Characteristics, Intermittent water supply, Seasons, Water distribution system, Water Microbiology, Water Supply},
	file = {ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\88WD6I9M\\S0043135413004909.html:text/html},
}


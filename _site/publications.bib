@article{oberg_conventional_2020,
	title = {Conventional Sewer Systems Are Too Time-Consuming, Costly and Inflexible to Meet the Challenges of the 21st Century},
	volume = {12},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	url = {https://www.mdpi.com/2071-1050/12/16/6518},
	doi = {10.3390/su12166518},
	abstract = {There is an urgent need for innovation in the sanitation sector because the conventional model (toilet-to-sewer-to-treatment) is too time-consuming and costly, and alternatives are lacking. We estimate the challenge ahead by developing scenarios for 60 of the fastest-growing urban conglomerates in the World. We find that the majority would need to build out their sewer systems at a rate that is ten to 50 times higher than the highest rate for any project in the World Bank\&rsquo;s database, which is unrealistic. We also carry out a case study of Lagos, Nigeria, which suggests that, in any given year, 14\&ndash;37\% of Lagos State\&rsquo;s budget would need to be invested to provide sanitation to the presently underserviced population while keeping up with population growth, which also is unrealistic. Our study provides clear evidence that the conventional model for sanitation is unworkable for rapidly growing urban areas. We conclude there is an urgent need to encourage and fund projects that promote innovations that can tackle the three core challenges: can be built sufficiently quickly, are flexible, and affordable. This is not likely to happen unless the future generation is systematically trained and educated to creatively support innovation in sustainable sanitation.},
	pages = {6518},
	number = {16},
	journaltitle = {Sustainability},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Öberg, Gunilla and Metson, Geneviève S. and Kuwayama, Yusuke and A. Conrad, Steven},
	urldate = {2021-09-02},
	date = {2020-01},
	langid = {english},
	note = {Number: 16},
	keywords = {illegal settlements, rapid urban growth, sanitation crisis, sustainable sanitation},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\JG8G4F7V\\Öberg et al. - 2020 - Conventional Sewer Systems Are Too Time-Consuming,.pdf:application/pdf;Snapshot:C\:\\Users\\banko\\Zotero\\storage\\F3W397DC\\6518.html:text/html},
}


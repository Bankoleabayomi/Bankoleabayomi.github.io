@article{abu-dalo_coupling_2022,
	title = {Coupling coagulation-flocculation to volcanic tuff-magnetite nanoparticles adsorption for olive mill wastewater treatment},
	volume = {17},
	issn = {2215-1532},
	url = {https://www.sciencedirect.com/science/article/pii/S2215153221002014},
	doi = {10.1016/j.enmm.2021.100626},
	abstract = {A combined coagulation-flocculation/adsorption approach has been developed to remove organic and phenolic compounds from Olive mill wastewater ({OMW}). The effect of utilizing coagulation-flocculation on the removal of total suspended solids ({TSS}) prior to volcanic tuff ({VT}) /magnetite nanoparticles ({MNPs}) adsorption was investigated. On the other hand, the influence of {VT} activation either by calcination or by acid/base treatment followed by calcination was established. Moreover, the adsorption capabilities of activated and non-activated {VT} coupled with magnetite nanoparticles were evaluated for chemical oxygen demand ({COD}) and total phenolic content ({TPC}) removal via batch and column approaches. The coagulation-flocculation processes were successfully reduced the {TSS}, {COD}, and {TPC} by 99\%, 48\% and 44\%, respectively. The removal efficiency of {VT} for {COD} was increased by acid activation followed by calcination. Further enhancement was achieved by coupling with 0.5\% by weight of magnetite nanoparticles with maximum {COD} removal of 76\% at {pH} 8. Instead, {VT} activated by calcination and coupled with 0.5\% by weight magnetite nanoparticles at {pH} 10 provided good removal for both {TPC} and {COD} of 73\% and 70\%, respectively. Overall, the results of this research reveal that the combined coagulation-flocculation/adsorption processes can enhance the removal of organic contaminants from {OMW}. This study has the potential to be considered as an efficient treatment approach for the local and worldwide olive mill industry.},
	pages = {100626},
	journaltitle = {Environmental Nanotechnology, Monitoring \& Management},
	author = {Abu-Dalo, Muna and Abdelnabi, Jehad and Al-Rawashdeh, Nathir A. F. and Albiss, Borhan and Al Bawab, Abeer},
	urldate = {2022-02-07},
	date = {2022-05-01},
	langid = {english},
	keywords = {Chemical oxygen demand, Magnetite nanoparticles, Olive mill wastewater, Total phenolic content, Volcanic tuff},
	file = {ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\G97SIGQF\\S2215153221002014.html:text/html},
}


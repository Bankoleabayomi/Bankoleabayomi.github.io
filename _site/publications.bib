@article{park_valuation_2017,
	title = {valuation of the image analysis method using statistics for determining the floc size and settling velocity in ballasted flocculation},
	volume = {99},
	issn = {1944-3986},
	url = {https://www.sciencedirect.com/science/article/pii/S1944398624129293},
	doi = {10.5004/dwt.2017.21643},
	series = {Selected papers presented at the conference on Efficient and Sustainable Water Systems Management toward Worth Living Development, 2nd {EWaS} 2016, Chania, Greece, June 1–4, 2016},
	abstract = {The global climate changes lead to more severe floods and droughts recently. Since the increase of nonpoint water contaminants, it is highly required the technology for the treatment of the high turbidity and the increased water volume in the water such as ballasted flocculation. The purpose of this study is to determine the floc size and settling velocity among the properties of the ballasted flocculation process. The appropriate number of floc samples which can be reliable in the use of the image analysis method was determined by comparing the statistical margin of error with the maximum experimental and measurement error. It was confirmed that a certain degree of reliability can be obtained at a confidence level of 95\% when 40 samples are measured whereas it is identified that when the confidence level is raised to 99\%, the number of samples must be 80 or more. On the other hand, it was confirmed that even if the number of samples is changed through the normal distribution density function curve using the average value calculated according to the number of samples, there was not much difference in the average value and standard deviation. In the ballast flocculation experiments of 25 and 120 μm using the number of samples set based on the reliability analysis, the floc size, and the settling velocity increased with the increase of the injection amount of the 25 μm ballast. In the case of the 120 μm ballast, the floc size did not increase significantly, but the average settling velocity increased as much as that of 25 μm ballast. This result implies the probability of the change of floc density.},
	pages = {220--227},
	journaltitle = {Desalination and Water Treatment},
	author = {Park, Seongjun and Moon, Yonggeol and Kim, Jong-Oh},
	urldate = {2026-01-20},
	date = {2017-12-01},
	keywords = {Statistical analysis, Water treatment, Image analysis, Ballasted flocculation},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\IHNFJ6RN\\Park et al. - 2017 - valuation of the image analysis method using statistics for determining the floc size and settling v.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\JNX7M4NR\\S1944398624129293.html:text/html},
}

@article{chaves_unsupervised_2025,
	title = {Unsupervised Change Detection Approach via Pseudo-Labeling, Machine Learning, and Spectral Index Time Series},
	volume = {17},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2071-1050},
	url = {https://www.mdpi.com/2071-1050/17/21/9536},
	doi = {10.3390/su17219536},
	abstract = {Land-use and land-cover change detection is critical for monitoring deforestation and urban expansion. In this study, we propose an unsupervised change detection approach that leverages multi-temporal satellite imagery combined with a classic machine learning algorithm trained on automatically generated pseudo-labels. Four distinct study areas were analyzed: a tropical forest region in the Brazilian Amazon, an agricultural frontier in the Amazon, a Brazilian Savanna area undergoing transformation, and a rapidly expanding urban zone around the new Istanbul Airport, in Türkiye. The performance of the proposed approach was evaluated and compared with modern unsupervised change detection methods, including the Wavelet Energy Correlation Screening and the Temporal Convolutional Autoencoder methods. The results demonstrate that the proposed framework achieved consistently high accuracy across all four study areas, with F1-scores of approximately 0.92 in dense forest, 0.87 in an agricultural frontier, 0.91 in the savanna area, and 0.89 in an urban expansion zone. Overall, the model outperformed or matched the performance of the baseline methods, attesting to its adaptability and generalization capability in diverse environmental contexts worldwide.},
	pages = {9536},
	number = {21},
	journaltitle = {Sustainability},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Chaves, Fellipe Mira and Negri, Rogério Galante and Alves, Larissa Mioni Vieira and Bressane, Adriano and Sekertekin, Aliihsan and da Silva, Erivaldo Antônio and Cardim, Guilherme Pina and Casaca, Wallace},
	urldate = {2026-01-22},
	date = {2025-01},
	langid = {english},
	keywords = {machine learning, time series, change detection, pseudo-label, spectral indices, unsupervised},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\2CWUM9UD\\Chaves et al. - 2025 - Unsupervised Change Detection Approach via Pseudo-Labeling, Machine Learning, and Spectral Index Tim.pdf:application/pdf},

	date = {2021},
	langid = {english},
	keywords = {Convolutional neural networks, Transformers, Fusion, Medical image segmentation},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\A55WYDX7\\Zhang et al. - 2021 - TransFuse Fusing Transformers and CNNs for Medical Image Segmentation.pdf:application/pdf},

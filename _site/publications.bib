	publisher = {Springer International Publishing},
	author = {Hazirbas, Caner and Ma, Lingni and Domokos, Csaba and Cremers, Daniel},
	editor = {Lai, Shang-Hong and Lepetit, Vincent and Nishino, Ko and Sato, Yoichi},
	date = {2017},
	langid = {english},
}


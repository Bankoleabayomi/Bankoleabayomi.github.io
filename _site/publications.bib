	number = {5},
	journaltitle = {Iran J Public Health},
	author = {Khalili, Fariba and Mahvi, Amir Hossein and Nasseri, Simin and Yunesian, Masood and Yaseri, Mehdi and Djahed, Babak},
	urldate = {2023-01-22},

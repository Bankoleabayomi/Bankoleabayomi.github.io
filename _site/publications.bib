	title = {Analysis of the Water System of the Ancient Roman City of Apamea},
	isbn = {978-90-481-8632-7},
	url = {https://doi.org/10.1007/978-90-481-8632-7_8},
	doi = {10.1007/978-90-481-8632-7_8},
	abstract = {In this chapter, a hydraulic system of the city of Apamea (Syria), operated during the 6th century A.D. (Byzantine period), is characterized. Flow rates and energy losses are calculated using global energy balances, coupled with local Computational Fluid Dynamics simulations, realized with the commercial software Fluent 6.3. This characterization provides a new quantitative description of the water supply system of the city, supplementing the usual field observations. Furthermore, the results of this hydraulic characterization are analyzed from an archaeological point of view. Three open historical questions about Apamea are considered. The analysis of the results of the hydraulic characterization allows to propose new interesting elements regarding the answer to these three questions.},

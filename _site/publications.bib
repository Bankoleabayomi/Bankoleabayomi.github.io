@article{lewandowski_groundwatersurface_2020,
	title = {Groundwater–Surface Water Interactions: Recent Advances and Interdisciplinary Challenges},
	volume = {12},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	url = {https://www.mdpi.com/2073-4441/12/1/296},
	doi = {10.3390/w12010296},
	shorttitle = {Groundwater–Surface Water Interactions},
	abstract = {The interactions of groundwater with surface waters such as streams, lakes, wetlands, or oceans are relevant for a wide range of reasons\&mdash;for example, drinking water resources may rely on hydrologic fluxes between groundwater and surface water. However, nutrients and pollutants can also be transported across the interface and experience transformation, enrichment, or retention along the flow paths and cause impacts on the interconnected receptor systems. To maintain drinking water resources and ecosystem health, a mechanistic understanding of the underlying processes controlling the spatial patterns and temporal dynamics of groundwater\&ndash;surface water interactions is crucial. This Special Issue provides an overview of current research advances and innovative approaches in the broad field of groundwater\&ndash;surface water interactions. The 20 research articles and 1 communication of this Special Issue cover a wide range of thematic scopes, scales, and experimental and modelling methods across different disciplines (hydrology, aquatic ecology, biogeochemistry, environmental pollution) collaborating in research on groundwater\&ndash;surface water interactions. The collection of research papers in this Special Issue also allows the identification of current knowledge gaps and reveals the challenges in establishing standardized measurement, observation, and assessment approaches. With regards to its relevance for environmental and water management and protection, the impact of groundwater\&ndash;surface water interactions is still not fully understood and is often underestimated, which is not only due to a lack of awareness but also a lack of knowledge and experience regarding appropriate measurement and analysis approaches. This lack of knowledge exchange from research into management practice suggests that more efforts are needed to disseminate scientific results and methods to practitioners and policy makers.},
	pages = {296},
	number = {1},
	journaltitle = {Water},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Lewandowski, Jörg and Meinikmann, Karin and Krause, Stefan},
	urldate = {2021-01-29},
	date = {2020-01},
	langid = {english},
	note = {Number: 1},
	keywords = {aquifer–stream interface, benthic zone, hyporheic zone, lacustrine groundwater discharge, riparian corridors, submarine groundwater discharge},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\N95HFSF4\\Lewandowski et al. - 2020 - Groundwater–Surface Water Interactions Recent Adv.pdf:application/pdf;Snapshot:C\:\\Users\\banko\\Zotero\\storage\\ZBNLUAAS\\296.html:text/html},
}


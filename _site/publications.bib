@article{moruzzi_enhancing_2024,
	title = {Enhancing flocculation kinetics assessment: Integrating aggregate size distribution into experimental and modelling frameworks},
	volume = {63},
	rights = {All rights reserved},
	issn = {2214-7144},
	url = {https://www.sciencedirect.com/science/article/pii/S2214714424006652},
	doi = {10.1016/j.jwpe.2024.105433},
	shorttitle = {Enhancing flocculation kinetics assessment},
	abstract = {Flocculation is crucial in drinking water treatment, yet conventional techniques like jar tests may lack precision in capturing particle heterogeneity. To overcome this, a non-intrusive image-based system was employed to directly assess flocculation using aggregate size distribution ({ASD}). Integrating {ASD} into a kinetic model with a single parameter (β) allowed for tracking {ASD} during flocculation. Bench and pilot-plant scale experiments validated our approach. Sensitivity analysis confirmed β's responsiveness to {ASD} variations (r {\textgreater} 0.92), with modelling indicating errors averaging around 5\%, underscoring its efficacy in assessing flocculation efficiency. Linking {ASD} coefficients from bench to pilot-scale models facilitates predicting flocculation performance.},

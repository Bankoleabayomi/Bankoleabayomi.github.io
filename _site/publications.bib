	author = {Asgharnejad, Hashem and Sarrafzadeh, Mohammad-Hossein},
	urldate = {2025-01-19},
	date = {2020-09-18},
	keywords = {image processing, activated sludge, Biomass quantification, Cell concentration, {RGB} analysis},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\CU2TXQX4\\Asgharnejad and Sarrafzadeh - 2020 - Development of Digital Image Processing as an Inno.pdf:application/pdf},

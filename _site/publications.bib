@article{firmino_towards_2020,
	title = {Towards Industry 4.0: a {SWOT}-based analysis for companies located in the Sorocaba Metropolitan Region (São Paulo State, Brazil)},
	volume = {27},
	issn = {0104-530X, 1806-9649},
	url = {https://www.scielo.br/j/gp/a/tdqBhbj5TDcztX5y9xzWGNg/},

@article{janssen_bubble_1984,
	title = {Bubble behaviour during oxygen and hydrogen evolution at transparent electrodes in {KOH} solution},
	volume = {29},
	issn = {0013-4686},
	url = {https://www.sciencedirect.com/science/article/pii/0013468684871224},
	doi = {10.1016/0013-4686(84)87122-4},
	abstract = {For oxygen and hydrogen evolving transparent nickel electrodes in {KOH} solutions, parameters characterizing the behaviour of bubbles which are adhered to the electrode surface during gas evolution, have been determined in dependence on current density, i, velocity of solution flow, v, pressure, p, temperature, T, and concentration of {KOH}. Based on experimental data a new basic bubble parameter, J, has been introduced, which accounts for the bubble behaviour. It has been found that J = a1ih1 and J/(J0−J) = a2vh2 where J0 = J at v = 0 ms−1 and a1,a2h1 and h2 are empirical constants; some of these depend on nature of gas evolved. Moreover, the parameter J is almost proportional to the {KOH} concentration, increases in a decreasing rate with increasing pressure and increases linearly with the reciprocal of the absolute temperature.},

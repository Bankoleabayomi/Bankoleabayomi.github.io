	keywords = {Trace elements, Pollution indices, Coastal Kerala, {ICP}-{MS}},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\VMR3RGPT\\Vineethkumar et al. - 2020 - Estimation of pollution indices and hazard evaluat.pdf:application/pdf;Snapshot:C\:\\Users\\banko\\Zotero\\storage\\3DFTFFW7\\s42269-020-00455-0.html:text/html},
}


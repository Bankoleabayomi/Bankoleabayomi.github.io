	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\QV4YUGJY\\Minier et al. - 2025 - Statistical Modeling of Particle Collisions in Tur.pdf:application/pdf},
}

@article{yang_quantitative_2025,
	title = {A quantitative method for assessing floc strength based on laminar shear force},
	issn = {1435-1536},
	url = {https://doi.org/10.1007/s00396-025-05409-4},
	doi = {10.1007/s00396-025-05409-4},
	abstract = {This paper establishes a quantitative calculation method for the strength of flocs under laminar shear force, where the key factors involved are the binding force and breaking force of flocs. The binding force of flocs is regarded as the floc strength, and the critical breaking force of flocs in laminar flow is considered a function of the shear rate (γ) and the area of flocs (A). The beaker experiments respectively explored the strength of flocs formed under different {PAC} dosages at a fixed stirring speed and different stirring speeds at a fixed dosage. It was discovered that the floc strength was the highest at a {PAC} dosage of 20 mg/L, reaching 11.89 {nN}; when the stirring speed was 80 r/min, the floc strength was the highest, attaining 13.33 {nN}. Furthermore, correlation analysis between the fractal dimension of flocs and their strength revealed a strong positive correlation with a correlation coefficient above 0.90 (p = 0.01). Finally, an integrated analysis of floc size, fractal dimension, and strength demonstrated that the turbidity removal rate is mainly determined by the floc size and floc strength, with the floc strength playing a dominant role in most cases. These findings provide theoretical guidance for improving the settling performance of flocs and developing efficient coagulation processes.},
	journaltitle = {Colloid Polym Sci},
	author = {Yang, Qing and Wang, Cheng and Ding, Yun and Zhao, Junguang and Ma, Le and Shang, Lifei},
	urldate = {2025-04-08},
	date = {2025-04-05},
	langid = {english},
	keywords = {Floc strength, Binding force, Crushing force, Laminar flow, Polymers},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\6AVZ3P3S\\Yang et al. - 2025 - A quantitative method for assessing floc strength .pdf:application/pdf},
}


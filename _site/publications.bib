@article{dai_floc_2019,
	title = {Floc Performance parameters during water treatment in a micro-vortex flocculation process determined by machine vision},
	volume = {40},
	issn = {0959-3330},
	doi = {10.1080/09593330.2018.1465127},
	abstract = {The coagulant dosage of an existing water plant is mainly determined based on the experience of water treatment process and influent/effluent water quality indexes that have time hysteresis effects. To solve this problem, the effect of coagulant dosage on a number of parameters used to evaluate the efficiency of flocculation in a setup was determined by using the micro-vortex flocculation technology in conjunction with the investigation of the relation between the equivalent diameter and the fractal dimension. By means of the machine vision system and computerized analysis, the effects of floc quantity, floc equivalent diameter and fractal dimension can be assessed. The correlations of these parameters with turbidity and ζ potential of the settling water, taken as measures for effluent quality, were explored. The study results show that the optimal flocculation effect with a turbidity removal rate of 97.9\% is achieved at the poly-aluminum chloride dosage of 20 mg/L. Meanwhile, a power exponential relation between the floc equivalent diameter and the fractal dimension was established with a correlation coefficient R2 of 0.826; relations among the effluent turbidity and the floc quantity, equivalent diameter, fractal dimension were established with a correlation coefficient R2 of 0.982, 0.851, and 0.875, respectively; equations between the ζ potential and the floc quantity, equivalent diameter, fractal dimension were also established where the correlation coefficient R2 were 0.868, 0.879, and 0.942, respectively. These results may provide excellent reference data for water plants to feed back the coagulant by floc performance parameters, which could relieve the hysteresis effect efficiently. © 2018, © 2018 Informa {UK} Limited, trading as Taylor \& Francis Group.},
	pages = {3062--3071},
	number = {23},
	journaltitle = {Environmental Technology (United Kingdom)},
	author = {Dai, H. and Qiu, Z. and Hu, F. and Gao, C. and Chen, Y.F. and Zhou, Z.},
	date = {2019},
	keywords = {fractal dimension, machine vision, equivalent diameter, floc performance parameter, Micro-vortex flocculation},
	file = {Dai et al. - 2019 - Floc Performance parameters during water treatment.pdf:C\:\\Users\\banko\\Zotero\\storage\\QK2E2RJ2\\Dai et al. - 2019 - Floc Performance parameters during water treatment.pdf:application/pdf;Snapshot:C\:\\Users\\banko\\Zotero\\storage\\66AFBBA3\\display.html:text/html},
}

@article{florindo_fractal_2024,
	title = {Fractal pooling: A new strategy for texture recognition using convolutional neural networks},
	volume = {243},
	issn = {0957-4174},
	doi = {10.1016/j.eswa.2023.122978},
	shorttitle = {Fractal pooling},
	abstract = {Texture recognition is an important task in computer vision and, as most problems in the area nowadays, has benefited from the use of deep convolutional neural networks. Nevertheless, typical architectures designed for object recognition usually do not perform optimally in such tasks. One of the most important elements of deep architectures in this application concerns the pooling operation. In particular, the well established global average pooling fails to capture more complex, multiscale and non-linear relation among the output activations. In this context, we propose fractal pooling, where the average is replaced by fractal dimension of the feature map. The new module is coupled with a convolutional backbone and a trainable residual block. The method is evaluated on texture classification, both on benchmark databases and on a real-world problem in botany. Our results are competitive with the state-of-the-art in texture classification, outperforming several modern deep learning approaches in terms of classification accuracy with the addition of minimal computational burden. The results suggest the potential of the proposed methodology for texture recognition in general and that using complexity measures is a promising strategy to perform pooling of deep features for this type of image. © 2023 Elsevier Ltd},
	journaltitle = {Expert Systems with Applications},
	author = {Florindo, J.B.},
	date = {2024},
	keywords = {Convolutional neural networks, Fractal geometry, Image descriptors, Texture recognition},
	file = {Snapshot:C\:\\Users\\banko\\Zotero\\storage\\MTFZBYEI\\display.html:text/html},
}


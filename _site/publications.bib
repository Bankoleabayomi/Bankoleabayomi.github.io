	langid = {english},
	keywords = {Machine learning, Flocculation, Hybrid modeling, Mechanistic model, Population balance model},
	file = {Nazemzadeh et al. - 2021 - Integration of first-principle models and machine .pdf:C\:\\Users\\banko\\Zotero\\storage\\WG6UWTV8\\Nazemzadeh et al. - 2021 - Integration of first-principle models and machine .pdf:application/pdf;Nazemzadeh et al. - 2021 - Integration of first-principle models and machine .pdf:C\:\\Users\\banko\\Zotero\\storage\\GN4TBQ2B\\Nazemzadeh et al. - 2021 - Integration of first-principle models and machine .pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\AG6V4SJA\\S0009250921004292.html:text/html},

	langid = {portuguese},
	keywords = {análise de imagem, Partículas, tratamento de água e flotação por ar dissolvido},
	file = {Full Text:C\:\\Users\\banko\\Zotero\\storage\\MDTHWB72\\Moruzzi and Reali - 2007 - Método para determinação de distribuição de tamanh.pdf:application/pdf},

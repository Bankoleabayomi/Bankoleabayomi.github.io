@article{marques_further_2022,
	title = {Further investigation of the irreversible floc breakup in flocculation kinetics modelling},
	volume = {22},
	issn = {1606-9749},
	url = {https://doi.org/10.2166/ws.2022.023},
	doi = {10.2166/ws.2022.023},
	abstract = {Recent research has shown that the equilibrium between aggregation and breakup in flocculation kinetics modelling may not hold due to irreversible floc breakup. This work investigated the influence of the coagulant/particle ratio and average velocity gradient () in the occurrence of this phenomenon with a different water matrix than previous research. Jar test assays were conducted with low (≈15 {NTU}), medium (≈50 {NTU}) and high (≈100 {NTU}) turbidity synthetic raw water, using alum as coagulant and kaolin as primary particles. Results were analyzed using Argaman and Kaufman's model and values for {KA} (aggregation constant) and {KB} (breakup coefficient) were determined with the evolutionary convergence method. Model fitting was satisfactory when the Al/particle ratio varied between 10 and 27 mg Al3+/g. Outside this range, residual turbidity increased after equilibrium, attributed to the irreversible floc breakup process and not adequately described by the model. A two-factor analysis of variance ({ANOVA}) was conducted, and the results indicated a plausible correlation between {pKA} (–log {KA}) and Al/particle ratio. As for {pKB} (–log {KB}), the results indicated a possible correlation with both Al/particle ratio and . The results suggest that the irreversible floc breakup may occur regardless of the water matrix composition.},
	pages = {3814--3823},
	number = {4},
	journaltitle = {Water Supply},
	author = {Marques, Rodrigo de Oliveira and Filho, Sidney Seckler Ferreira},
	urldate = {2023-01-28},
	date = {2022-01-19},
	file = {Marques and Filho - 2022 - Further investigation of the irreversible floc bre.pdf:C\:\\Users\\banko\\Zotero\\storage\\7S6I5HRE\\Marques and Filho - 2022 - Further investigation of the irreversible floc bre.pdf:application/pdf},
}


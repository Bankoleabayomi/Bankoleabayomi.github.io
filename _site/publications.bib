	url = {https://www.sciencedirect.com/science/article/pii/S2352801X20300175},
	doi = {10.1016/j.gsd.2020.100385},
	abstract = {Egypt is one of the most water-scarce countries of the Middle East and North Africa region and is highly vulnerable to climatic changes. In the Egyptian deserts, new land reclamation projects depend mainly on groundwater as the main source of water. Also, solar energy is the most promising renewable source of energy for pumping and transport of water. Moghra region is one of the well-known “1.5 Million Acres Reclamation Projects” areas in the Western Desert. In this paper, a groundwater model was constructed and used to investigate the sustainable groundwater management scenarios in Moghra region taking into consideration impacts of the expected climate changes. Using {MODFLOW}/{GMS} software, Moghra model was prepared and calibrated based on the region's topographic, climatic, geologic and hydrologeolgic conditions. The model was used to explore the impacts of climate changes; Sea Level Rise ({SLR}) by 1.0 m and temperature increase by 2°0C and 40°C on the management scenarios. In addition, the required power for water management after 5, 10, 50 and 100 years were determined. It was concluded that the best management scenario is to use 1000 wells to extract 1.2 Mm3/d of water for serving a total area of 85,714 acres (360 km2). This scenario satisfies the project criteria that permits a maximum drawdown less than 1 m/year. It was also concluded that {SLR} has mild effects on groundwater levels due to the vast aquifer dimensions. Additionally, the increase in evapotranspiration due to temperature increase will lead to a significant increase in the consumptive use. The power needed to extract water will continuously increase due to the expected increase in drawdown. The required area for Photovoltaic ({PV}) solar plant was determined and its value increased by 6\% and 12\% due to temperature increase of 2°C and 4°C, respectively.},
	pages = {100385},
	journaltitle = {Groundwater for Sustainable Development},
	author = {Sayed, Ebtehal and Riad, Peter and Elbeih, Salwa F. and Hassan, Ahmed A. and Hagras, Mona},
	urldate = {2022-04-12},
	date = {2020-10-01},
	langid = {english},
	keywords = {Climate change, Groundwater management, Solar energy, {ArcGIS}, {MODFLOW}/{GMS}, Moghra aquifer},
	file = {Sayed et al. - 2020 - Sustainable groundwater management in arid regions.pdf:C\:\\Users\\banko\\Zotero\\storage\\NS46T2RJ\\Sayed et al. - 2020 - Sustainable groundwater management in arid regions.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\4TDF2V46\\S2352801X20300175.html:text/html},
}

@article{khairy_drainage_2022,
	title = {Drainage water reuse strategies: Case of El-Bats drain, Fayoum Governorate, Egypt},
	volume = {13},
	issn = {2090-4479},
	url = {https://www.sciencedirect.com/science/article/pii/S2090447921004597},
	doi = {10.1016/j.asej.2021.101681},
	shorttitle = {Drainage water reuse strategies},
	abstract = {Several challenges facing the water resources managers in many Egyptian governorates that suffer from rapid growth and unbalanced distribution of population. Typically, these governorates need to supplement their limited water resources by filling the gap between water supply and demand. This research aims to evaluate the opportunities to expand the drainage water reuse ({DWR}) practice in Fayoum Governorate ({FG}) region. El-Bats drain which lies in the Eastern part of Fayoum region was evaluated for the possible {DWR}. Intensive sampling campaigns were carried out during the period from 2009 to 2018 to analyze 14 water quality parameters ({WQPs}) covering agricultural, domestic and industrial pollution levels. Different univariate and multivariate statistical tools were employed to assess the collected sampling data including descriptive statistics, percentile analysis, hierarchal cluster analyses as well as mass balance computation for pollution loads. The obtained results showed the capability of some reaches of El-Bats drain for {DWR} in irrigation after mixing with canal fresh water by variable mixing ratios. In addition, the need for employing proper treatment facilities in other reaches.},
	pages = {101681},
	number = {5},
	journaltitle = {Ain Shams Engineering Journal},

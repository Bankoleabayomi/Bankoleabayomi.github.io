@article{oliveira_mathematical_2019,
	title = {Mathematical modelling and analysis of the flocculation process in low retention time hydraulic flocculators},
	volume = {45},
	rights = {Copyright (c) 0},
	issn = {1816-7950},
	url = {https://watersa.net/article/view/6669},
	doi = {10.4314/wsa.v45i1.01},
	abstract = {This article aims to advance the understanding of particle interactions in low retention time flocculators and proposes a new flocculation model that appropriately considers the influence of retention time in flocculation processes. This consideration is important for units with flocculation time lower than 1 min, as seen in helically coiled tube flocculators ({HCTFs}), whose retention time is significantly lower than conventional flocculation units (about 30 min). With this, it was possible to obtain a more adherent model, reducing deviations between results obtained by physical modelling (using {HCTFs}, 48 tests) and those obtained with the proposed model, when compared with results obtained using the flocculation models commonly used for this purpose. The decreasing-rising behaviour presented by experimental data for process efficiency versus retention time, not verified in the benchmark models, was satisfactorily addressed by the proposed model. Furthermore, maximum and average absolute percentage deviations obtained using the model proposed in this study were less than or equal to the results obtained with the benchmark models and less for experimental uncertainty (10\%). The results obtained indicate that this model can be a useful tool to support the rational design of low retention time units, including applications for the water industry and water recycling systems.},
	number = {1},
	journaltitle = {Water {SA}},
	author = {Oliveira, Danieli Soares de and Donadel, Clainer Bravin},
	urldate = {2024-04-08},
	date = {2019-01-31},
	langid = {english},
	note = {Number: 1 January},
	keywords = {flocculation models, helically coiled tube flocculators ({HCTFs}), hydraulic flocculators, mathematical modelling, physical modelling},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\FDYPPJ2L\\Oliveira and Donadel - 2019 - Mathematical modelling and analysis of the floccul.pdf:application/pdf},
}

@article{bukhtawar_optimization_2024,
	title = {Optimization of multi-stage micellar-enhanced flocculation process for removal of Levofloxacin hemihydrate in wastewater},
	volume = {59},
	issn = {2214-7144},
	url = {https://www.sciencedirect.com/science/article/pii/S2214714424002034},
	doi = {10.1016/j.jwpe.2024.104971},
	abstract = {This study aims to optimize a multi-stage micellar flocculation process to eliminate the persistent antibiotic Levofloxacin Hemihydrate ({LH}) in water sources by using a micellar flocculation process with multiple stages. This process provides superior efficiency compared to conventional methods by utilizing an eco-friendly anionic surfactant and a multivalent salt for flocculation. It was found that 0.020 mol/L soap concentration achieved an 85 \% {LH} removal rate at room temperature in a one-minute contact time. Micellar structure changes and re-solubilization decreases removal efficiency as soap concentration increases. Increasing {pH} levels results in higher removal efficiency. The adsorption mechanism was studied using Langmuir, Freundlich, Temkin, Dubinin-Radushkevich, and Frenkel-Halsey-Hill isotherm models, along with pseudo-first order and second-order models, film diffusion and intraparticle diffusion models of adsorption kinetics. The Langmuir and Temkin models fitted the adsorption isotherm better than other models, with an R2 of 98.13 \% and 97.29 \% respectively. The pseudo-second-order kinetic model best fits the experimental data of the {MEF} process with an R2 of approximately 99.39 \%. Thermodynamic assessments indicate that at lower temperatures spontaneous events occur and that the process is exothermic.},
	pages = {104971},
	journaltitle = {Journal of Water Process Engineering},
	author = {Bukhtawar, Fiza and Usman, Muhammad and Haq, Atta Ul and Saeed, Muhammad and Saleem, Atif},
	urldate = {2024-04-08},
	date = {2024-03-01},
	keywords = {Biobased soap, Kinetics aspects, Levofloxacin hemihydrates, Multivalent salt, Thermodynamics},
	file = {ScienceDirect Snapshot:C\:\\Users\\banko\\Zotero\\storage\\NWGVKGHL\\S2214714424002034.html:text/html},
}

@article{igwegbe_green_2024,
	title = {Green flocculation for  sustainable remediation of municipal landfill leachate using Parkia biglobosa extract: optimization, mechanistic insights and implication for design},
	issn = {1618-9558},
	url = {https://doi.org/10.1007/s10098-024-02815-0},
	doi = {10.1007/s10098-024-02815-0},
	shorttitle = {Green flocculation for  sustainable remediation of municipal landfill leachate using Parkia biglobosa extract},
	abstract = {The escalating challenges posed by municipal landfill leachate ({MUNL}) necessitate the quest for green and sustainable solutions. This study aims to introduce Parkia biglobosa seed extract ({PKSE}) as a potential novel eco-friendly flocculant for efficacious removal of total suspended solids ({TSS}) from {MUNL}. Real {MUNL} samples were obtained from an active landfill managed by Anambra State Waste Management Authority ({ASWAMA}) Nigeria, enabling the optimization of operational parameters. The objectives encompass assessing {PKSE} applicability in {MUNL} treatment, extending beyond removal efficiency; optimizing the {MUNL} remediation process using response surface methodology ({RSM}); conducting a comprehensive cost–benefit analysis; exploring the coagulation–flocculation kinetics governing the treatment process; and utilizing optimized parameters for designing a type {II} settling tank. Physiochemical characteristics of {PKSE} were determined via Fourier transform infrared ({FTIR}) and scanning electron microscopy ({SEM}) methodologies, which revealed its suitability for this purpose. Optimal conditions unveil a remarkable {TSS}: 95.84\% with a 29-min settling time, employing 50 mg/L {PKSE} dosage at {pH} 12. Stochastic appraisal endorses cost–benefit viability and sedimentation models, ensuring residuals ≤ 30 mg/L. The proposed tank geometry (aspect ratio of 2/1) aligns with {MUNL} concentration, offering a pragmatic design implication. This study pioneers green flocculation, harmonizing environmental remediation.},
	journaltitle = {Clean Techn Environ Policy},
	author = {Igwegbe, Chinenye Adaobi and Ovuoraye, Prosper Eguono and Białowiec, Andrzej and Onukwuli, Okechukwu Dominic and Balogun, Philip Ayodele},
	urldate = {2024-04-08},
	date = {2024-04-01},
	langid = {english},
	keywords = {Leachate, Coagulation–flocculation, Cost benefit analysis, Parkia biglobosa, Settling tank geometry, Total suspended solids},
	file = {Full Text PDF:C\:\\Users\\banko\\Zotero\\storage\\GT2ANHSX\\Igwegbe et al. - 2024 - Green flocculation for  sustainable remediation of.pdf:application/pdf},
}


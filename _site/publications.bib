	keywords = {Computer Science - Machine Learning, Computer Science - Computer Vision and Pattern Recognition, Computer Science - Artificial Intelligence},
	file = {Preprint PDF:C\:\\Users\\banko\\Zotero\\storage\\NBN7UTSQ\\Dosovitskiy et al. - 2021 - An Image is Worth 16x16 Words Transformers for Im.pdf:application/pdf;Snapshot:C\:\\Users\\banko\\Zotero\\storage\\LV3W2MFI\\2010.html:text/html},
}

